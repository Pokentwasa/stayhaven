# Existing Stay Haven booking engine integration.
# Fill these in with the real values once provided; the site degrades to a
# disabled "coming soon" booking state when they are absent.

# Base URL of the existing booking engine (e.g. https://book.stayhavencollection.com)
NEXT_PUBLIC_BOOKING_ENGINE_URL=

# If the booking engine expects a specific site/account identifier
NEXT_PUBLIC_BOOKING_ENGINE_SITE_ID=

# Set to "iframe" to embed the existing engine inside the booking overlay,
# or "redirect" to hand off to it in a new tab/window at the final step.
NEXT_PUBLIC_BOOKING_ENGINE_MODE=redirect
